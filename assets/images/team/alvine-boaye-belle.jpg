.gform_wrapper .name_first>input, .gform_wrapper .name_last>input {
	margin-bottom: 0px;
}
/*gravity forms iframes--padding clears horizontal scroll bar at the bottom for smaller screens*/
.gform_body {
	padding-left:1px;
	padding-right:1px;
}

