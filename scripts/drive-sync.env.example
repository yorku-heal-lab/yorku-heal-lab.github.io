# Copy to drive-sync.env and edit (drive-sync.env is gitignored).
#
# Spreadsheets are pulled via public share links in drive-data-links.yml (no rclone).

# Git branch to pull and push (default: main)
# GIT_BRANCH=main

# Optional: override links manifest (default: scripts/drive-data-links.yml)
# DRIVE_LINKS_YML=/path/to/drive-data-links.yml

# Optional: Python interpreter (defaults to python3, or .venv/bin/python if present)
# PYTHON=/usr/bin/python3

# Optional: log directory (default: scripts/logs)
# LOG_DIR=
